# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Both values are public (they ship inside the website), so they're safe in a
# browser app. NEVER put the service_role / secret key here.
#
# Leave them empty to run in demo mode (everything stays in this browser).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare Turnstile *site* key (public) for the sign-up / sign-in bot check.
# The matching *secret* key goes in Supabase (Auth → Bot and Abuse Protection),
# never here. Leave empty to skip the check (e.g. while captcha is off in Supabase).
VITE_TURNSTILE_SITE_KEY=
